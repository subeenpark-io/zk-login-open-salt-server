# Master Seed (32 bytes = 64 hex characters)
# Generate with: npm run generate-seed
MASTER_SEED=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Test JWT for Salt API testing (optional)
# Get from: https://developers.google.com/oauthplayground/
# Steps:
#   1. Select "Google OAuth2 API v2" scopes: openid, email, profile
#   2. Click "Authorize APIs"
#   3. Exchange code for tokens
#   4. Copy the "id_token" value here
TEST_JWT=