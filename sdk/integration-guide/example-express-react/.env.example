# 백엔드 설정
PORT=3000
SALT_PROVIDER_TYPE=mysten  # mysten, local, 또는 custom
# MASTER_SEED=0x1234567890abcdef...  # local 모드인 경우 필요
# SALT_ENDPOINT=https://custom-salt-server.com/v1/salt  # custom 모드인 경우 필요

# 프론트엔드 설정 (Vite)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_SALT_ENDPOINT=http://localhost:3000/api/zklogin/salt
